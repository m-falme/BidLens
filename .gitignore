# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
# Office lock files (a workbook open in Excel)
~$*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets never committed; the template is
.env*
.env*.local
!.env.example

# vercel
.vercel

# supabase CLI link state (project ref, pooler URL); local only
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
